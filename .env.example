# Copy to .env (git-ignored) and fill in. scripts/start.sh loads it.
# LLM for incident summaries: any OpenAI-compatible endpoint. Leave the key empty to use
# the built-in template summaries. Check the provider's docs for current model names.
#
# Groq:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=
#
# Gemini (OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=
# LLM_API_KEY=

# Warehouse connection (default below). With Docker Postgres on another host port
# (docker-compose.yml, PG_PORT=5433), change the port here.
# WAREHOUSE_DSN=postgresql://secops:secops@localhost:5432/secops
